{
  "name": "hoondy-leaderboard",
  "version": "2.0.0",
  "private": true,
  "description": "Monthly leaderboards and anonymous LQ test statistics for hoondy.com (Cloudflare Worker + D1).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute hoondy-leaderboard --local --file schema.sql",
    "db:init:remote": "wrangler d1 execute hoondy-leaderboard --remote --file schema.sql",
    "db:migrate:local": "wrangler d1 execute hoondy-leaderboard --local --file sql/0002-monthly-and-lq-stats.sql",
    "db:migrate:remote": "wrangler d1 execute hoondy-leaderboard --remote --file sql/0002-monthly-and-lq-stats.sql",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/ip.test.js test/units.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.144.0"
  }
}
